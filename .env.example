# Variables d'environnement de `ollama.cpp`.
#
# @spec docs/BACKLOG.md OC-010 « Configuration centralisée »
# @spec docs/DAT.md §6 « Authentification et autorisation », §7 « Sécurité »
# @spec README.md « Variables d'environnement »
#
# Copier ce fichier en `.env.staging` ou `.env.prod` et compléter. AUCUNE valeur réelle de secret
# ne doit être écrite ici ni committée : ce fichier ne contient que des exemples inoffensifs.
#
# Format : NOM=valeur. Toute variable laissée vide est traitée comme absente, donc la valeur par
# défaut s'applique — un `VAR=` dans un Compose n'écrase jamais un défaut par accident.

# --- Service HTTP -----------------------------------------------------------------------------
# Interface d'écoute. Obligatoire : non (défaut 0.0.0.0).
OLLAMACPP_HOST=0.0.0.0
# Port d'écoute. Obligatoire : non (défaut 11434, le port attendu par les clients Ollama).
OLLAMACPP_PORT=11434
# Port publié sur l'hôte par Compose. Obligatoire : non (défaut 11434, 11435 en staging).
OLLAMACPP_PUBLISH_PORT=11434
# Version annoncée par `GET /api/version`. Certains clients Ollama la comparent pour activer des
# fonctionnalités. Obligatoire : non (défaut 0.12.0).
OLLAMACPP_VERSION=0.12.0
# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR. Obligatoire : non (défaut INFO).
OLLAMACPP_LOG_LEVEL=INFO

# --- Stockage ---------------------------------------------------------------------------------
# Répertoire des modèles (blobs + manifests). Obligatoire : non (défaut ~/.ollama.cpp/models ;
# /models dans l'image Docker).
OLLAMACPP_MODELS=/models
# Chemin hôte monté sur /models en production. Un volume nommé est utilisé si absent.
OLLAMACPP_MODELS_HOST_PATH=

# --- Backend d'inférence ----------------------------------------------------------------------
# Chemin du binaire `llama-server`. Obligatoire : non (défaut llama-server dans le PATH).
OLLAMACPP_LLAMA_SERVER_BIN=/usr/local/bin/llama-server
# Interface d'écoute des instances filles. NE PAS exposer hors de la boucle locale.
OLLAMACPP_LLAMA_SERVER_HOST=127.0.0.1
# Plage de ports privée des instances filles. Obligatoire : non (défaut 18000-18999).
OLLAMACPP_LLAMA_SERVER_PORT_MIN=18000
OLLAMACPP_LLAMA_SERVER_PORT_MAX=18999
# Délai maximal de chargement d'un modèle, en secondes. Un très gros modèle sur disque lent peut
# demander plus que le défaut. Obligatoire : non (défaut 300).
OLLAMACPP_LOAD_TIMEOUT_S=300
# Délai maximal d'une requête d'inférence, en secondes. Obligatoire : non (défaut 600).
OLLAMACPP_REQUEST_TIMEOUT_S=600

# --- Cycle de vie et ordonnancement -------------------------------------------------------------
# Durée de résidence par défaut. Accepte un nombre de SECONDES ou une durée (`5m`, `1h30m`).
# Une valeur négative signifie « résidence illimitée ». Obligatoire : non (défaut 5m).
OLLAMACPP_KEEP_ALIVE=5m
# Nombre maximal de modèles résidents simultanément. Obligatoire : non (défaut 3).
OLLAMACPP_MAX_LOADED_MODELS=3
# Budget mémoire en octets. 0 = déduit de la mémoire de l'hôte. À fixer explicitement sur une
# machine partagée, pour cantonner `ollama.cpp`. Obligatoire : non (défaut 0).
OLLAMACPP_MEMORY_LIMIT_BYTES=0
# Limite mémoire du conteneur, au format Docker. Obligatoire : non (défaut 24g en production).
OLLAMACPP_MEMORY_LIMIT=24g
# Marge de sécurité sur le budget mémoire, entre 0 et 1. Obligatoire : non (défaut 0.10).
OLLAMACPP_MEMORY_SAFETY_MARGIN=0.10
# Contexte par défaut quand ni la requête, ni le manifest, ni le GGUF ne le précisent.
OLLAMACPP_DEFAULT_CONTEXT=4096

# --- Téléchargement ---------------------------------------------------------------------------
# Nombre de téléchargements simultanés. Obligatoire : non (défaut 2).
OLLAMACPP_DOWNLOAD_CONCURRENCY=2
# URL du registre privé. Vide = aucun registre privé configuré. Obligatoire : non.
OLLAMACPP_REGISTRY_URL=
# SECRET — jeton du registre privé, envoyé en `Authorization: Bearer`. Ne jamais committer.
# Exemple de FORME uniquement, à remplacer : OLLAMACPP_REGISTRY_TOKEN=<jeton fourni par le registre>
OLLAMACPP_REGISTRY_TOKEN=
# Point d'entrée Hugging Face. Obligatoire : non (défaut https://huggingface.co).
# Réseau : ce domaine ne sert que l'API et la redirection. Le fichier GGUF est servi par un hôte
# de stockage distinct (`us.aws.cdn.hf.co`, `eu.aws.cdn.hf.co`, ou `cdn-lfs*` pour les anciens
# dépôts), qui doit aussi être autorisé en sortie. Voir README.md, « Accès réseau requis ».
OLLAMACPP_HF_ENDPOINT=https://huggingface.co
# SECRET — jeton Hugging Face, requis seulement pour les dépôts privés ou sous licence acceptée.
OLLAMACPP_HF_TOKEN=

# --- Garde-fous -------------------------------------------------------------------------------
# SECRET — si défini, tout appel non public doit porter `Authorization: Bearer <clé>`.
# Laisser vide derrière `ollama-gateway`, qui porte déjà les clés API par client.
OLLAMACPP_API_KEY=
# Autorise la gestion du catalogue (`pull`, `create`, `copy`, `delete`, `blobs`).
# Mettre à `false` en production : le catalogue se gère depuis la console d'administration.
OLLAMACPP_MANAGEMENT_ENABLED=false
