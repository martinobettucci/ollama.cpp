#!/usr/bin/env bash
# Lance l'environnement de PRODUCTION de `ollama.cpp`.
#
# @spec docs/BACKLOG.md OC-091 « runDev / runStaging / runProd »
# @spec docs/DAT.md §12 « Commandes »
# @spec docs/PROD_MIGRATIONS.md
set -euo pipefail
cd "$(dirname "$0")"
if [[ ! -f .env.prod ]]; then
  echo "erreur : .env.prod manquant — copier .env.example et le compléter" >&2
  exit 2
fi
exec docker compose -f docker-compose.prod.yml "${@:-up --build -d}"
